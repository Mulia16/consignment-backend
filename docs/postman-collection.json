          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"itemCode\": \"ITEM001\",\n  \"itemName\": \"Laptop Pro 15 Updated\",\n  \"variant\": \"32GB/1TB Black\",\n  \"hierarchy\": \"CONSIGNMENT\",\n  \"itemModel\": \"LP-15-2024-V2\",\n  \"unitRetail\": 18000000,\n  \"mvc\": 14000000,\n  \"categoryL1\": \"Electronics\",\n  \"categoryL2\": \"Computers\",\n  \"categoryL3\": \"Laptops\"\n}" },
