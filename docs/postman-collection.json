            "body": { "mode": "raw", "raw": "{\n  \"supplierCode\": \"SUPP001\",\n  \"supplierType\": \"EXTERNAL\",\n  \"contractNumber\": \"CONTRACT-2024-001\",\n  \"consigneeCompany\": \"COMP01\",\n  \"consigneeStore\": \"STORE01\",\n  \"currentInventoryQty\": 0\n}" },
            "url": { "raw": "{{baseUrl}}/consignment/api/consignment-setup/item/ITEM001/external-supplier", "host": ["{{baseUrl}}"], "path": ["consignment","api","consignment-setup","item","ITEM001","external-supplier"] }
          }
        },
