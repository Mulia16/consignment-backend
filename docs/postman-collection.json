{
  "info": {
    "name": "CMS - Consignment Management System",
    "_postman_id": "cms-v3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": [
            "var j = pm.response.json();",
            "if (j.data && j.data.token) pm.collectionVariables.set('token', j.data.token);"
          ]}}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"secret123\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] }
          },
          "response": [{
            "name": "200 OK",
            "status": "OK", "code": 200,
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": "{\n  \"message\": \"Login successful\",\n  \"status\": 200,\n  \"data\": {\n    \"token\": \"eyJhbGciOiJIUzM4NCJ9...\",\n    \"token_type\": \"Bearer\",\n    \"expires_in\": 86400,\n    \"username\": \"admin\",\n    \"roles\": [\"ROLE_ADMIN\"]\n  }\n}"
          }, {
            "name": "401 Unauthorized",
            "status": "Unauthorized", "code": 401,
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": "{\n  \"message\": \"Invalid username or password\",\n  \"status\": 401\n}"
          }]
        },
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"user1\",\n  \"email\": \"user1@example.com\",\n  \"password\": \"password123\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] }
          },
          "response": [{
            "name": "201 Created",
            "status": "Created", "code": 201,
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": "{\n  \"message\": \"User registered successfully\",\n  \"status\": 201\n}"
          }, {
            "name": "400 Username Taken",
            "status": "Bad Request", "code": 400,
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": "{\n  \"message\": \"Username already taken\",\n  \"status\": 400\n}"
          }]
        },
        {
          "name": "Validate Token",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/validate", "host": ["{{baseUrl}}"], "path": ["auth","validate"] }
          },
          "response": [{
            "name": "200 Valid",
            "status": "OK", "code": 200,
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": "{\n  \"message\": \"success\",\n  \"status\": 200,\n  \"data\": { \"valid\": true, \"username\": \"admin\" }\n}"
          }, {
            "name": "401 Revoked",
            "status": "Unauthorized", "code": 401,
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": "{\n  \"message\": \"Token has been revoked\",\n  \"status\": 401\n}"
          }]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth","logout"] }
          },
          "response": [{
            "name": "200 OK",
            "status": "OK", "code": 200,
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": "{\n  \"message\": \"Logged out successfully\",\n  \"status\": 200\n}"
          }]
        }
      ]
    },
    {
      "name": "02 - Consignment Setup",
      "item": [
        {
          "name": "List Items",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/consignment/api/consignment-setup/items?page=1&perPage=20",
              "host": ["{{baseUrl}}"], "path": ["consignment","api","consignment-setup","items"],
              "query": [
                { "key": "page", "value": "1" }, { "key": "perPage", "value": "20" },
                { "key": "itemCode", "value": "", "disabled": true },
                { "key": "itemName", "value": "", "disabled": true },
                { "key": "variant", "value": "", "disabled": true },
                { "key": "hierarchy", "value": "", "description": "CONSIGNMENT / OUTRIGHT", "disabled": true },
                { "key": "categoryL1", "value": "", "disabled": true },
                { "key": "categoryL2", "value": "", "disabled": true }
              ]
            }
          },
          "response": [{
            "name": "200 OK",
            "status": "OK", "code": 200,
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": "{\n  \"message\": \"success\",\n  \"status\": 200,\n  \"data\": [\n    {\n      \"itemCode\": \"ITEM001\",\n      \"itemName\": \"Laptop Pro 15\",\n      \"variant\": \"16GB/512GB Silver\",\n      \"hierarchy\": \"CONSIGNMENT\",\n      \"itemModel\": \"LP-15-2024\",\n      \"unitRetail\": 15000000.0,\n      \"mvc\": 12000000.0,\n      \"category\": { \"l1\": \"Electronics\", \"l2\": \"Computers\", \"l3\": \"Laptops\" },\n      \"externalSuppliers\": [\n        {\n          \"setupId\": \"abc-123\",\n          \"supplierCode\": \"SUPP001\",\n          \"supplierType\": \"EXTERNAL\",\n          \"contractNumber\": \"CONTRACT-2024-001\",\n          \"consignees\": [\n            { \"companyId\": \"COMP01\", \"stores\": [\"STORE01\", \"STORE02\"] }\n          ]\n        }\n      ],\n      \"internalSuppliers\": []\n    }\n  ],\n  \"meta\": { \"page\": 1, \"perPage\": 20, \"totalData\": 1, \"totalPage\": 1 }\n}"
          }]
        },
        {
          "name": "Get Item by Code",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/consignment/api/consignment-setup/item/ITEM001", "host": ["{{baseUrl}}"], "path": ["consignment","api","consignment-setup","item","ITEM001"] }
          },
          "response": [{
            "name": "200 OK",
            "status": "OK", "code": 200,
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": "{\n  \"message\": \"success\",\n  \"status\": 200,\n  \"data\": {\n    \"itemCode\": \"ITEM001\",\n    \"itemName\": \"Laptop Pro 15\",\n    \"variant\": \"16GB/512GB Silver\",\n    \"hierarchy\": \"CONSIGNMENT\",\n    \"itemModel\": \"LP-15-2024\",\n    \"unitRetail\": 15000000.0,\n    \"mvc\": 12000000.0,\n    \"category\": { \"l1\": \"Electronics\", \"l2\": \"Computers\", \"l3\": \"Laptops\" },\n    \"externalSuppliers\": [\n      {\n        \"setupId\": \"abc-123\",\n        \"supplierCode\": \"SUPP001\",\n        \"supplierType\": \"EXTERNAL\",\n        \"contractNumber\": \"CONTRACT-2024-001\",\n        \"consignees\": [\n          { \"companyId\": \"COMP01\", \"stores\": [\"STORE01\", \"STORE02\"] }\n        ]\n      }\n    ],\n    \"internalSuppliers\": [\n      {\n        \"setupId\": \"def-456\",\n        \"supplierCode\": \"INT-SUPP01\",\n        \"supplierStore\": \"STORE01\",\n        \"consignees\": [\n          { \"companyId\": \"COMP01\", \"stores\": [\"STORE02\"] }\n        ]\n      }\n    ]\n  }\n}"
          }, {
            "name": "404 Not Found",
            "status": "Not Found", "code": 404,
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": "{\n  \"message\": \"Consignment setup not found for item: ITEM999\",\n  \"status\": 404\n}"
          }]
        },
        {
          "name": "Create Item Setup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"itemCode\": \"ITEM003\",\n  \"itemName\": \"Laptop Pro 15\",\n  \"variant\": \"16GB/512GB Silver\",\n  \"hierarchy\": \"CONSIGNMENT\",\n  \"itemModel\": \"LP-15-2024\",\n  \"unitRetail\": 15000000,\n  \"mvc\": 12000000,\n  \"categoryL1\": \"Electronics\",\n  \"categoryL2\": \"Computers\",\n  \"categoryL3\": \"Laptops\"\n}" },
            "url": { "raw": "{{baseUrl}}/consignment/api/consignment-setup/items", "host": ["{{baseUrl}}"], "path": ["consignment","api","consignment-setup","items"] }
          },
          "response": [{
            "name": "201 Created",
            "status": "Created", "code": 201,
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": "{\n  \"message\": \"Item setup created\",\n  \"status\": 201,\n  \"data\": {\n    \"itemCode\": \"ITEM003\",\n    \"itemName\": \"Laptop Pro 15\",\n    \"variant\": \"16GB/512GB Silver\",\n    \"hierarchy\": \"CONSIGNMENT\",\n    \"itemModel\": \"LP-15-2024\",\n    \"unitRetail\": 15000000.0,\n    \"mvc\": 12000000.0,\n    \"category\": { \"l1\": \"Electronics\", \"l2\": \"Computers\", \"l3\": \"Laptops\" },\n    \"externalSuppliers\": [],\n    \"internalSuppliers\": []\n  }\n}"
          }]
        },
        {
          "name": "Update Item Setup",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"itemCode\": \"ITEM001\",\n  \"itemName\": \"Laptop Pro 15 Updated\",\n  \"variant\": \"32GB/1TB Black\",\n  \"hierarchy\": \"CONSIGNMENT\",\n  \"itemModel\": \"LP-15-2024-V2\",\n  \"unitRetail\": 18000000,\n  \"mvc\": 14000000,\n  \"categoryL1\": \"Electronics\",\n  \"categoryL2\": \"Computers\",\n  \"categoryL3\": \"Laptops\"\n}" },
            "url": { "raw": "{{baseUrl}}/consignment/api/consignment-setup/item/ITEM001", "host": ["{{baseUrl}}"], "path": ["consignment","api","consignment-setup","item","ITEM001"] }
          },
          "response": [{
            "name": "200 OK",
            "status": "OK", "code": 200,
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": "{\n  \"message\": \"Item setup updated\",\n  \"status\": 200,\n  \"data\": {\n    \"itemCode\": \"ITEM001\",\n    \"itemName\": \"Laptop Pro 15 Updated\",\n    \"variant\": \"32GB/1TB Black\",\n    \"hierarchy\": \"CONSIGNMENT\",\n    \"itemModel\": \"LP-15-2024-V2\",\n    \"unitRetail\": 18000000.0,\n    \"mvc\": 14000000.0,\n    \"category\": { \"l1\": \"Electronics\", \"l2\": \"Computers\", \"l3\": \"Laptops\" },\n    \"externalSuppliers\": [],\n    \"internalSuppliers\": []\n  }\n}"
          }]
        },
        {
          "name": "Add External Supplier",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"supplierCode\": \"SUPP001\",\n  \"supplierType\": \"EXTERNAL\",\n  \"contractNumber\": \"CONTRACT-2024-001\",\n  \"consignees\": [\n    { \"companyId\": \"COMP01\", \"storeIds\": [\"STORE01\", \"STORE02\"] },\n    { \"companyId\": \"COMP02\", \"storeIds\": [\"STORE03\"] }\n  ]\n}" },
            "url": { "raw": "{{baseUrl}}/consignment/api/consignment-setup/item/ITEM001/external-supplier", "host": ["{{baseUrl}}"], "path": ["consignment","api","consignment-setup","item","ITEM001","external-supplier"] }
          },
          "response": [{
            "name": "201 Created",
            "status": "Created", "code": 201,
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": "{\n  \"message\": \"External supplier added\",\n  \"status\": 201,\n  \"data\": {\n    \"setupId\": \"abc-123\",\n    \"supplierCode\": \"SUPP001\",\n    \"supplierType\": \"EXTERNAL\",\n    \"contractNumber\": \"CONTRACT-2024-001\",\n    \"consignees\": [\n      { \"companyId\": \"COMP01\", \"stores\": [\"STORE01\", \"STORE02\"] },\n      { \"companyId\": \"COMP02\", \"stores\": [\"STORE03\"] }\n    ]\n  }\n}"
          }]
        },
        {
          "name": "Update External Supplier",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"supplierCode\": \"SUPP001\",\n  \"supplierType\": \"EXTERNAL\",\n  \"contractNumber\": \"CONTRACT-2024-001\",\n  \"consignees\": [\n    { \"companyId\": \"COMP01\", \"storeIds\": [\"STORE01\", \"STORE02\", \"STORE04\"] }\n  ]\n}" },
            "url": { "raw": "{{baseUrl}}/consignment/api/consignment-setup/item/ITEM001/external-supplier/SUPP001/CONTRACT-2024-001", "host": ["{{baseUrl}}"], "path": ["consignment","api","consignment-setup","item","ITEM001","external-supplier","SUPP001","CONTRACT-2024-001"] }
          },
          "response": [{
            "name": "200 OK",
            "status": "OK", "code": 200,
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": "{\n  \"message\": \"External supplier updated\",\n  \"status\": 200,\n  \"data\": {\n    \"setupId\": \"abc-123\",\n    \"supplierCode\": \"SUPP001\",\n    \"supplierType\": \"EXTERNAL\",\n    \"contractNumber\": \"CONTRACT-2024-001\",\n    \"consignees\": [\n      { \"companyId\": \"COMP01\", \"stores\": [\"STORE01\", \"STORE02\", \"STORE04\"] }\n    ]\n  }\n}"
          }]
        },
        {
          "name": "Delete External Supplier",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/consignment/api/consignment-setup/item/ITEM001/external-supplier/SUPP001/CONTRACT-2024-001", "host": ["{{baseUrl}}"], "path": ["consignment","api","consignment-setup","item","ITEM001","external-supplier","SUPP001","CONTRACT-2024-001"] }
          },
          "response": [{
            "name": "200 OK",
            "status": "OK", "code": 200,
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": "{\n  \"message\": \"External supplier deleted\",\n  \"status\": 200\n}"
          }]
        },
        {
          "name": "Add Internal Supplier",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"supplierCode\": \"INT-SUPP01\",\n  \"supplierStore\": \"STORE01\",\n  \"consignees\": [\n    { \"companyId\": \"COMP01\", \"storeIds\": [\"STORE02\", \"STORE03\"] }\n  ]\n}" },
            "url": { "raw": "{{baseUrl}}/consignment/api/consignment-setup/item/ITEM001/internal-supplier", "host": ["{{baseUrl}}"], "path": ["consignment","api","consignment-setup","item","ITEM001","internal-supplier"] }
          },
          "response": [{
            "name": "201 Created",
            "status": "Created", "code": 201,
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": "{\n  \"message\": \"Internal supplier added\",\n  \"status\": 201,\n  \"data\": {\n    \"setupId\": \"def-456\",\n    \"supplierCode\": \"INT-SUPP01\",\n    \"supplierStore\": \"STORE01\",\n    \"consignees\": [\n      { \"companyId\": \"COMP01\", \"stores\": [\"STORE02\", \"STORE03\"] }\n    ]\n  }\n}"
          }]
        },
        {
          "name": "Update Internal Supplier",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"supplierCode\": \"INT-SUPP01\",\n  \"supplierStore\": \"STORE01\",\n  \"consignees\": [\n    { \"companyId\": \"COMP01\", \"storeIds\": [\"STORE02\", \"STORE03\", \"STORE04\"] }\n  ]\n}" },
            "url": { "raw": "{{baseUrl}}/consignment/api/consignment-setup/item/ITEM001/internal-supplier/INT-SUPP01/STORE01", "host": ["{{baseUrl}}"], "path": ["consignment","api","consignment-setup","item","ITEM001","internal-supplier","INT-SUPP01","STORE01"] }
          },
          "response": [{
            "name": "200 OK",
            "status": "OK", "code": 200,
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": "{\n  \"message\": \"Internal supplier updated\",\n  \"status\": 200,\n  \"data\": {\n    \"setupId\": \"def-456\",\n    \"supplierCode\": \"INT-SUPP01\",\n    \"supplierStore\": \"STORE01\",\n    \"consignees\": [\n      { \"companyId\": \"COMP01\", \"stores\": [\"STORE02\", \"STORE03\", \"STORE04\"] }\n    ]\n  }\n}"
          }]
        },
        {
          "name": "Delete Internal Supplier",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/consignment/api/consignment-setup/item/ITEM001/internal-supplier/INT-SUPP01/STORE01", "host": ["{{baseUrl}}"], "path": ["consignment","api","consignment-setup","item","ITEM001","internal-supplier","INT-SUPP01","STORE01"] }
          },
          "response": [{
            "name": "200 OK",
            "status": "OK", "code": 200,
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": "{\n  \"message\": \"Internal supplier deleted\",\n  \"status\": 200\n}"
          }]
        }
      ]
    },
