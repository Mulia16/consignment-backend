          "name": "Delete External Supplier",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/consignment/api/consignment-setup/item/ITEM001/external-supplier/:id", "host": ["{{baseUrl}}"], "path": ["consignment","api","consignment-setup","item","ITEM001","external-supplier",":id"], "variable": [{ "key": "id", "value": "" }] }
