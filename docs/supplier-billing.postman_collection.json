{
  "info": {
    "name": "Supplier Billing (SCBR)",
    "description": "Supplier Consignment Billing Request API — compute, search, get, release, delete.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "scbrId",  "value": "" }
  ],
  "item": [
    {
      "name": "1. Compute SCBR",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/supplier-billing/compute",
          "host": ["{{baseUrl}}"],
          "path": ["api", "supplier-billing", "compute"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"company\": \"COMPANY01\",\n  \"store\": \"STORE01\",\n  \"supplierCode\": \"SUP001\",\n  \"supplierContract\": \"CONTRACT001\",\n  \"periodType\": \"MONTHLY\",\n  \"fromDate\": \"2024-01-01\",\n  \"toDate\": \"2024-01-31\",\n  \"carryForwardDecimal\": true,\n  \"createdBy\": \"admin\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.data && json.data.id) {",
              "  pm.collectionVariables.set('scbrId', json.data.id);",
              "  console.log('scbrId set to:', json.data.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Search SCBR",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/supplier-billing?company=COMPANY01&store=STORE01&supplierCode=SUP001&periodType=MONTHLY&status=HELD&page=1&perPage=20",
          "host": ["{{baseUrl}}"],
          "path": ["api", "supplier-billing"],
          "query": [
            { "key": "company",          "value": "COMPANY01" },
            { "key": "store",            "value": "STORE01" },
            { "key": "supplierCode",     "value": "SUP001" },
            { "key": "supplierContract", "value": "CONTRACT001", "disabled": true },
            { "key": "docNo",            "value": "",            "disabled": true },
            { "key": "periodType",       "value": "MONTHLY" },
            { "key": "status",           "value": "HELD" },
            { "key": "processStatus",    "value": "",            "disabled": true },
            { "key": "fromDate",         "value": "2024-01-01",  "disabled": true },
            { "key": "toDate",           "value": "2024-01-31",  "disabled": true },
            { "key": "page",             "value": "1" },
            { "key": "perPage",          "value": "20" }
          ]
        }
      }
    },
    {
      "name": "3. Get SCBR by ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/supplier-billing/{{scbrId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "supplier-billing", "{{scbrId}}"]
        }
      }
    },
    {
      "name": "4. Release SCBR",
      "request": {
        "method": "PUT",
        "url": {
          "raw": "{{baseUrl}}/api/supplier-billing/{{scbrId}}/release",
          "host": ["{{baseUrl}}"],
          "path": ["api", "supplier-billing", "{{scbrId}}", "release"]
        }
      }
    },
    {
      "name": "5. Delete SCBR (reprocess)",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/supplier-billing/{{scbrId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "supplier-billing", "{{scbrId}}"]
        }
      }
    }
  ]
}
