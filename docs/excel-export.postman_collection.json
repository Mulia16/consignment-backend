    {
      "name": "Inventory & Stock Reports",
      "item": [
        {
          "name": "Supplier Book Value Inventory — Export Excel",
          "request": {
            "method": "GET",
            "description": "Book value per batch per supplier.",
            "url": {
              "raw": "{{baseUrl}}/api/report/supplier-book-value/export?company=COMPANY01&store=STORE01&supplierCode=SUP001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "report", "supplier-book-value", "export"],
              "query": [
                { "key": "company",          "value": "COMPANY01" },
                { "key": "store",            "value": "STORE01" },
                { "key": "supplierCode",     "value": "SUP001" },
                { "key": "supplierContract", "value": "",        "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Customer Consignment Inventory — Export Excel",
          "request": {
            "method": "GET",
            "description": "Balance per customer per store.",
            "url": {
              "raw": "{{baseUrl}}/api/report/customer-inventory/export?store=STORE01&customerCode=CUST001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "report", "customer-inventory", "export"],
              "query": [
                { "key": "store",        "value": "STORE01" },
                { "key": "customerCode", "value": "CUST001" }
              ]
            }
          }
        },
        {
          "name": "Reservations — Export Excel",
          "request": {
            "method": "GET",
            "description": "List semua reservasi stok.",
            "url": {
              "raw": "{{baseUrl}}/api/report/reservations/export?store=STORE01",
              "host": ["{{baseUrl}}"],
              "path": ["api", "report", "reservations", "export"],
              "query": [
                { "key": "store",     "value": "STORE01" },
                { "key": "itemCode",  "value": "",        "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Item Store Supplier (Consignment Setup) — Export Excel",
          "request": {
            "method": "GET",
            "description": "Mapping item-supplier-store.",
            "url": {
              "raw": "{{baseUrl}}/api/report/consignment-setup/export?company=COMPANY01&store=STORE01",
              "host": ["{{baseUrl}}"],
              "path": ["api", "report", "consignment-setup", "export"],
              "query": [
