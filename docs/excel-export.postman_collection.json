{
  "info": {
    "name": "CMS — Excel Export",
    "description": "Semua endpoint download Excel (.xlsx) untuk report Consignment Management System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "Transaction Reports",
      "item": [
        {
          "name": "CSRQ Report — Export Excel",
          "request": {
            "method": "GET",
            "description": "Export transaksi CSRQ ke Excel. Ganti {type} dengan: CSRQ / CSRV / CSO / CSDO / CSR / CSA",
            "url": {
              "raw": "{{baseUrl}}/api/report/CSRQ/export?company=COMPANY01&store=STORE01&supplierCode=SUP001&fromDate=2024-01-01&toDate=2024-01-31&status=RELEASED",
              "host": ["{{baseUrl}}"],
              "path": ["api", "report", "CSRQ", "export"],
              "query": [
                { "key": "company",      "value": "COMPANY01" },
                { "key": "store",        "value": "STORE01" },
                { "key": "supplierCode", "value": "SUP001" },
                { "key": "customerCode", "value": "",        "disabled": true },
                { "key": "fromDate",     "value": "2024-01-01" },
                { "key": "toDate",       "value": "2024-01-31" },
                { "key": "status",       "value": "RELEASED" }
              ]
            }
          }
        },
        {
          "name": "CSRV Report — Export Excel",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/report/CSRV/export?company=COMPANY01&store=STORE01&supplierCode=SUP001&fromDate=2024-01-01&toDate=2024-01-31",
