            }
          }
        }
      ]
    },
    {
      "name": "Settlement Reports",
      "item": [
        {
          "name": "Settlement Summary — Export Excel",
          "request": {
            "method": "GET",
            "description": "Summary semua settlement (supplier & customer).",
            "url": {
              "raw": "{{baseUrl}}/api/report/settlement-summary/export?company=COMPANY01&store=STORE01&settlementType=SUPPLIER&fromDate=2024-01-01&toDate=2024-01-31",
              "host": ["{{baseUrl}}"],
              "path": ["api", "report", "settlement-summary", "export"],
              "query": [
                { "key": "company",        "value": "COMPANY01" },
                { "key": "store",          "value": "STORE01" },
                { "key": "settlementType", "value": "SUPPLIER" },
                { "key": "fromDate",       "value": "2024-01-01" },
                { "key": "toDate",         "value": "2024-01-31" },
                { "key": "status",         "value": "",           "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Settlement Detail — Export Excel",
          "request": {
            "method": "GET",
            "description": "Detail per settlement ID.",
            "url": {
              "raw": "{{baseUrl}}/api/report/settlement-detail/:settlementId/export",
              "host": ["{{baseUrl}}"],
              "path": ["api", "report", "settlement-detail", ":settlementId", "export"],
              "variable": [
                { "key": "settlementId", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Supplier Billing — Export Excel",
          "request": {
            "method": "GET",
            "description": "Export Supplier Consignment Billing Request (SCBR) ke Excel. Berisi header + detail per item.",
            "url": {
              "raw": "{{baseUrl}}/api/report/supplier-billing/export?company=COMPANY01&store=STORE01&supplierCode=SUP001&fromDate=2024-01-01&toDate=2024-01-31",
              "host": ["{{baseUrl}}"],
              "path": ["api", "report", "supplier-billing", "export"],
              "query": [
                { "key": "company",          "value": "COMPANY01" },
                { "key": "store",            "value": "STORE01" },
                { "key": "supplierCode",     "value": "SUP001" },
                { "key": "supplierContract", "value": "",         "disabled": true },
                { "key": "status",           "value": "",         "disabled": true },
                { "key": "fromDate",         "value": "2024-01-01" },
                { "key": "toDate",           "value": "2024-01-31" }
              ]
            }
          }
        },
