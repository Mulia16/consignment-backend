<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.consignment.service.persistence.mapper.CsrnMapper">

    <resultMap id="CsrnHeaderResultMap" type="com.consignment.service.persistence.model.CsrnHeaderEntity">
        <id property="id" column="id"/>
        <result property="docNo" column="doc_no"/>
        <result property="csoDocNo" column="cso_doc_no"/>
        <result property="company" column="company"/>
        <result property="store" column="store"/>
        <result property="supplierCode" column="supplier_code"/>
        <result property="supplierContract" column="supplier_contract"/>
        <result property="internalSupplierStore" column="internal_supplier_store"/>
        <result property="reasonCode" column="reason_code"/>
        <result property="remark" column="remark"/>
        <result property="status" column="status"/>
        <result property="createdBy" column="created_by"/>
        <result property="referenceNo" column="reference_no"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <resultMap id="CsrnDetailResultMap" type="com.consignment.service.persistence.model.CsrnDetailEntity">
        <id property="id" column="id"/>
        <result property="csrnId" column="csrn_id"/>
        <result property="itemCode" column="item_code"/>
        <result property="uom" column="uom"/>
        <result property="qty" column="qty"/>
    </resultMap>

    <resultMap id="CsrnCHeaderResultMap" type="com.consignment.service.persistence.model.CsrnCHeaderEntity">
        <id property="id" column="id"/>
        <result property="docNo" column="doc_no"/>
        <result property="csrnId" column="csrn_id"/>
        <result property="csrnDocNo" column="csrn_doc_no"/>
        <result property="csoDocNo" column="cso_doc_no"/>
        <result property="company" column="company"/>
        <result property="store" column="store"/>
        <result property="supplierCode" column="supplier_code"/>
        <result property="supplierContract" column="supplier_contract"/>
        <result property="reasonCode" column="reason_code"/>
        <result property="remark" column="remark"/>
        <result property="createdBy" column="created_by"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <resultMap id="CsrnCDetailResultMap" type="com.consignment.service.persistence.model.CsrnCDetailEntity">
        <id property="id" column="id"/>
        <result property="csrnCId" column="csrn_c_id"/>
        <result property="itemCode" column="item_code"/>
        <result property="uom" column="uom"/>
        <result property="qty" column="qty"/>
    </resultMap>

    <!-- ==================== CSRN ==================== -->

    <insert id="insertHeader" parameterType="com.consignment.service.persistence.model.CsrnHeaderEntity">
        INSERT INTO csrn_header (id, doc_no, cso_doc_no, company, store, supplier_code, supplier_contract,
            internal_supplier_store, reason_code, remark, status, created_by, reference_no, created_at, updated_at)
        VALUES (#{id}, #{docNo}, #{csoDocNo}, #{company}, #{store}, #{supplierCode}, #{supplierContract},
            #{internalSupplierStore}, #{reasonCode}, #{remark}, #{status}, #{createdBy}, #{referenceNo},
            CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)
    </insert>

    <insert id="insertDetail" parameterType="com.consignment.service.persistence.model.CsrnDetailEntity">
        INSERT INTO csrn_detail (id, csrn_id, item_code, uom, qty)
        VALUES (#{id}, #{csrnId}, #{itemCode}, #{uom}, #{qty})
    </insert>

    <delete id="deleteDetails">
        DELETE FROM csrn_detail WHERE csrn_id = #{csrnId}
    </delete>

    <select id="findHeaderById" resultMap="CsrnHeaderResultMap">
        SELECT id, doc_no, cso_doc_no, company, store, supplier_code, supplier_contract,
               internal_supplier_store, reason_code, remark, status, created_by, reference_no,
               created_at, updated_at
        FROM csrn_header WHERE id = #{id}
    </select>

    <sql id="csrnFilterWhere">
        <where>
            <if test="c.docNo != null and c.docNo != ''">AND h.doc_no ILIKE CONCAT('%', #{c.docNo}, '%')</if>
            <if test="c.company != null and c.company != ''">AND h.company = #{c.company}</if>
            <if test="c.store != null and c.store != ''">AND h.store = #{c.store}</if>
            <if test="c.supplierCode != null and c.supplierCode != ''">AND h.supplier_code = #{c.supplierCode}</if>
            <if test="c.csoDocNo != null and c.csoDocNo != ''">AND h.cso_doc_no = #{c.csoDocNo}</if>
            <if test="c.status != null and c.status != ''">AND h.status = #{c.status}</if>
            <if test="c.createdBy != null and c.createdBy != ''">AND h.created_by = #{c.createdBy}</if>
            <if test="c.itemCode != null and c.itemCode != ''">AND d.item_code = #{c.itemCode}</if>
            <if test="c.updatedFrom != null">AND DATE(h.updated_at) &gt;= #{c.updatedFrom}</if>
            <if test="c.updatedTo != null">AND DATE(h.updated_at) &lt;= #{c.updatedTo}</if>
        </where>
    </sql>

    <select id="searchHeaders" resultMap="CsrnHeaderResultMap">
        SELECT DISTINCT h.id, h.doc_no, h.cso_doc_no, h.company, h.store, h.supplier_code, h.supplier_contract,
               h.internal_supplier_store, h.reason_code, h.remark, h.status, h.created_by, h.reference_no,
               h.created_at, h.updated_at
        FROM csrn_header h
        LEFT JOIN csrn_detail d ON d.csrn_id = h.id
        <include refid="csrnFilterWhere"/>
        ORDER BY h.created_at DESC
        LIMIT #{c.perPage} OFFSET #{c.offset}
    </select>

    <select id="countHeaders" resultType="long">
        SELECT COUNT(DISTINCT h.id) FROM csrn_header h
        LEFT JOIN csrn_detail d ON d.csrn_id = h.id
        <include refid="csrnFilterWhere"/>
    </select>

    <select id="findDetailsByHeaderId" resultMap="CsrnDetailResultMap">
        SELECT id, csrn_id, item_code, uom, qty FROM csrn_detail
        WHERE csrn_id = #{csrnId} ORDER BY item_code ASC
    </select>

    <update id="updateStatus">
        UPDATE csrn_header SET status = #{status}, updated_at = CURRENT_TIMESTAMP WHERE id = #{id}
    </update>

    <select id="findMaxDocNoNumber" resultType="long">
        SELECT COALESCE(MAX(CAST(SUBSTRING(doc_no FROM 6) AS BIGINT)), 0)
        FROM csrn_header WHERE doc_no ~ '^CSRN-[0-9]+$'
    </select>

    <!-- ==================== CSRN-C ==================== -->

    <insert id="insertCHeader" parameterType="com.consignment.service.persistence.model.CsrnCHeaderEntity">
        INSERT INTO csrn_c_header (id, doc_no, csrn_id, csrn_doc_no, cso_doc_no, company, store,
            supplier_code, supplier_contract, reason_code, remark, created_by, created_at)
        VALUES (#{id}, #{docNo}, #{csrnId}, #{csrnDocNo}, #{csoDocNo}, #{company}, #{store},
            #{supplierCode}, #{supplierContract}, #{reasonCode}, #{remark}, #{createdBy}, CURRENT_TIMESTAMP)
    </insert>

    <insert id="insertCDetail" parameterType="com.consignment.service.persistence.model.CsrnCDetailEntity">
        INSERT INTO csrn_c_detail (id, csrn_c_id, item_code, uom, qty)
        VALUES (#{id}, #{csrnCId}, #{itemCode}, #{uom}, #{qty})
    </insert>

    <select id="findCHeaderById" resultMap="CsrnCHeaderResultMap">
        SELECT id, doc_no, csrn_id, csrn_doc_no, cso_doc_no, company, store,
               supplier_code, supplier_contract, reason_code, remark, created_by, created_at
        FROM csrn_c_header WHERE id = #{id}
    </select>

    <select id="findCHeaderByCsrnId" resultMap="CsrnCHeaderResultMap">
        SELECT id, doc_no, csrn_id, csrn_doc_no, cso_doc_no, company, store,
               supplier_code, supplier_contract, reason_code, remark, created_by, created_at
        FROM csrn_c_header WHERE csrn_id = #{csrnId}
        ORDER BY created_at DESC LIMIT 1
    </select>

    <sql id="csrnCFilterWhere">
        <where>
            <if test="c.docNo != null and c.docNo != ''">AND h.doc_no ILIKE CONCAT('%', #{c.docNo}, '%')</if>
            <if test="c.company != null and c.company != ''">AND h.company = #{c.company}</if>
            <if test="c.store != null and c.store != ''">AND h.store = #{c.store}</if>
            <if test="c.supplierCode != null and c.supplierCode != ''">AND h.supplier_code = #{c.supplierCode}</if>
            <if test="c.supplierContract != null and c.supplierContract != ''">AND h.supplier_contract = #{c.supplierContract}</if>
            <if test="c.reasonCode != null and c.reasonCode != ''">AND h.reason_code = #{c.reasonCode}</if>
            <if test="c.createdBy != null and c.createdBy != ''">AND h.created_by = #{c.createdBy}</if>
            <if test="c.csrnDocNo != null and c.csrnDocNo != ''">AND h.csrn_doc_no ILIKE CONCAT('%', #{c.csrnDocNo}, '%')</if>
            <if test="c.createdFrom != null">AND DATE(h.created_at) &gt;= #{c.createdFrom}</if>
            <if test="c.createdTo != null">AND DATE(h.created_at) &lt;= #{c.createdTo}</if>
        </where>
    </sql>

    <select id="searchCHeaders" resultMap="CsrnCHeaderResultMap">
        SELECT h.id, h.doc_no, h.csrn_id, h.csrn_doc_no, h.cso_doc_no, h.company, h.store,
               h.supplier_code, h.supplier_contract, h.reason_code, h.remark, h.created_by, h.created_at
        FROM csrn_c_header h
        <include refid="csrnCFilterWhere"/>
        ORDER BY h.created_at DESC
        LIMIT #{c.perPage} OFFSET #{c.offset}
    </select>

    <select id="countCHeaders" resultType="long">
        SELECT COUNT(h.id) FROM csrn_c_header h
        <include refid="csrnCFilterWhere"/>
    </select>

    <select id="findCDetailsByCHeaderId" resultMap="CsrnCDetailResultMap">
        SELECT id, csrn_c_id, item_code, uom, qty FROM csrn_c_detail
        WHERE csrn_c_id = #{csrnCId} ORDER BY item_code ASC
    </select>

    <select id="findMaxCDocNoNumber" resultType="long">
        SELECT COALESCE(MAX(CAST(SUBSTRING(doc_no FROM 8) AS BIGINT)), 0)
        FROM csrn_c_header WHERE doc_no ~ '^CSRN-C-[0-9]+$'
    </select>

</mapper>
