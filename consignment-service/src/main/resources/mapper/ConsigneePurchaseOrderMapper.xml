<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.consignment.service.persistence.mapper.ConsigneePurchaseOrderMapper">

    <resultMap id="ConsigneePurchaseOrderResultMap" type="com.consignment.service.persistence.model.ConsigneePurchaseOrderEntity">
        <id property="id" column="id"/>
        <result property="poNumber" column="po_number"/>
        <result property="store" column="store"/>
        <result property="itemCode" column="item_code"/>
        <result property="itemName" column="item_name"/>
        <result property="orderedQty" column="ordered_qty"/>
        <result property="status" column="status"/>
        <result property="poDate" column="po_date"/>
        <result property="syncedAt" column="synced_at"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByStore" resultMap="ConsigneePurchaseOrderResultMap">
        SELECT id, po_number, store, item_code, item_name, ordered_qty, status, po_date, synced_at, created_at, updated_at
        FROM consignee_purchase_orders
        WHERE store = #{store}
    </select>

</mapper>
